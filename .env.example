# Copy this file to .env and fill in real values. .env is gitignored.

# --- General ---
NODE_ENV=development

# --- Frontend ---
# BUILD_TARGET selects the Dockerfile stage: "dev" (hot-reload dev server)
# or "production" (optimized static build served by nginx).
BUILD_TARGET=dev
# Port the container listens on internally: 5173 for dev, 80 for production.
FRONTEND_CONTAINER_PORT=5173
# Port exposed on your host machine (the one you open in the browser).
FRONTEND_PORT=5173
# Optional, dev-only: pre-fills the Settings > Assistant API key field locally
# so you don't have to paste it in by hand. Never bundled into a production
# build (frontend/src/lib/assistant-config.ts gates it behind import.meta.env.DEV,
# which Vite dead-code-eliminates entirely from prod builds) — still, only put a
# real key in your own .env (gitignored), never here.
# VITE_OPENROUTER_API_KEY=
